@MultiShop.Cargo.WebApi_HostAddress = http://localhost:5299

GET {{MultiShop.Cargo.WebApi_HostAddress}}/openapi/v1.json
Accept: application/json

###
# Cargo Companies
###

GET {{MultiShop.Cargo.WebApi_HostAddress}}/api/cargo-companies
Accept: application/json

###

GET {{MultiShop.Cargo.WebApi_HostAddress}}/api/cargo-companies/1
Accept: application/json

###

POST {{MultiShop.Cargo.WebApi_HostAddress}}/api/cargo-companies
Content-Type: application/json

{
  "companyName": "Yurtiçi Kargo",
  "companyEmail": "info@yurticikargo.com",
  "companyPhoneNumber": "+90 212 444 99 99",
  "companyAddress": "Maslak Mah. Büyükdere Cad. No:10 İstanbul"
}

###

PUT {{MultiShop.Cargo.WebApi_HostAddress}}/api/cargo-companies/1
Content-Type: application/json

{
  "id": 1,
  "companyName": "Yurtiçi Kargo A.Ş.",
  "companyEmail": "destek@yurticikargo.com",
  "companyPhoneNumber": "+90 212 444 99 99",
  "companyAddress": "Maslak Mah. Büyükdere Cad. No:12 İstanbul",
  "isActive": true
}

###

DELETE {{MultiShop.Cargo.WebApi_HostAddress}}/api/cargo-companies/1

