@page "/User/Index"
@model MultiShop.Web.Pages.User.IndexModel
@{
    Layout = null;
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container">
    <br /><br /><br />
    <h3>Kullanıcı Profil Bilgisi</h3>
    <div class="alert alert-info">Kullanıcı Id: @Model.UserDetail.Id</div>
    <div class="alert alert-warning">Kullanıcı Adı: @Model.UserDetail.Username</div>
    <div class="alert alert-info">Ad Soyad: @Model.UserDetail.Name @Model.UserDetail.Surname</div>
    <div class="alert alert-warning">Email Adresi: @Model.UserDetail.Email</div>
</div>
