@page "/Admin/About/UpdateAbout/{id}"
@model MultiShop.Web.Areas.Admin.Pages.About.UpdateAboutModel

@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Areas/Admin/Pages/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">

        <div class="col-md-12">
            <div class="chart-box">
                <h4>Hakkımda Alanı Güncelleme Sayfası</h4>
                <br />
                <div class="bs-example" data-example-id="bordered-table">

                    <form method="post">
                        <input type="hidden" asp-for="Input.AboutId" />
                        <label>Açıklama</label>
                        <input type="text" class="form-control" asp-for="Input.Description" />
                        <br />
                        <label>Adres</label>
                        <input type="text" class="form-control" asp-for="Input.Address" />
                        <br />
                        <label>Email</label>
                        <input type="text" class="form-control" asp-for="Input.Email" />
                        <br />
                        <label>Telefon</label>
                        <input type="text" class="form-control" asp-for="Input.Phone" />
                        <br />
                        <button class="btn btn-success">Hakkımda Alanını Güncelle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>


