@page "/Admin/Product/CreateProduct"
@model MultiShop.Web.Areas.Admin.Pages.Product.CreateProductModel

@{
    ViewData["Title"] = "CreateProduct";
    Layout = "~/Areas/Admin/Pages/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">

        <div class="col-md-12">
            <div class="chart-box">
                <h4>Ürün Ekleme Sayfası</h4>
                <br />
                <div class="bs-example" data-example-id="bordered-table">

                    <form method="post">
                        <label>Ürün Adı</label>
                        <input type="text" class="form-control" asp-for="Input.ProductName" />
                        <br />
                        <label>Ürün Fiyatı</label>
                        <input type="text" class="form-control" asp-for="Input.ProductPrice" />
                        <br />
                        <label>Ürün Görseli</label>
                        <input type="text" class="form-control" asp-for="Input.ProductImageUrl" />
                        <br />
                        <label>Ürün Kategorisi</label>
                        @Html.DropDownListFor(x => x.Input.CategoryId, Model.CategoryValues,new {@class="form-control"})
                        <br />
                        <label>Ürün Açıklaması</label>
                        <textarea class="form-control" asp-for="Input.ProductDescription" rows="5"></textarea>
                        <br />
                        <button class="btn btn-primary">Ürünü Ekle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
