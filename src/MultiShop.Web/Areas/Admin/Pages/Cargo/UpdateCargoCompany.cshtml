@page "/Admin/Cargo/UpdateCargoCompany/{id?}"
@model MultiShop.Web.Areas.Admin.Pages.Cargo.UpdateCargoCompanyModel

@{
    ViewData["Title"] = "UpdateCargoCompany";
    Layout = "~/Areas/Admin/Pages/Shared/_AdminLayout.cshtml";
}



<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Kargo Şirketi Ekleme Sayfası</h4>
                <br />
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <input type="hidden" asp-for="Input.cargoCompanyId" />
                        <label>Kargo Şirketi Adı</label>
                        <input type="text" class="form-control" asp-for="Input.cargoCompanyName" />
                        <br />
                        <button class="btn btn-success">Kargo Şirketini Güncelle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
