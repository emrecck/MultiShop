@page "/Admin/ProductImage/ProductImageDetail/{id}"
@model MultiShop.Web.Areas.Admin.Pages.ProductImage.ProductImageDetailModel

@{
    ViewData["Title"] = "ProductImageDetail";
    Layout = "~/Areas/Admin/Pages/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">

        <div class="col-md-12">
            <div class="chart-box">
                <h4>Ürün Görselleri Güncelleme Sayfası</h4>
                <br />
                <div class="bs-example" data-example-id="bordered-table">

                    <form method="post">
                        <input type="hidden" asp-for="Input.ProductImageID" />
                        <input type="hidden" asp-for="Input.ProductId" />
                        <label>Görsel 1</label>
                        <input type="text" class="form-control" asp-for="Input.Image1" />
                        <br />
                        <label>Görsel 2</label>
                        <input type="text" class="form-control" asp-for="Input.Image2" />
                        <br />
                        <label>Görsel 3</label>
                        <input type="text" class="form-control" asp-for="Input.Image3" />
                        <br />
                        <label>Görsel 4</label>
                        <input type="text" class="form-control" asp-for="Input.Image4" />
                        <br />
                        <button class="btn btn-success">Ürün Görsellerini Güncelle</button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>

