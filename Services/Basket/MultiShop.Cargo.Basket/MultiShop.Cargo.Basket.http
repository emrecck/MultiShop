@MultiShop.Cargo.Basket_HostAddress = http://localhost:5147
@AccessToken = YOUR_ACCESS_TOKEN

GET {{MultiShop.Cargo.Basket_HostAddress}}/openapi/v1.json
Accept: application/json

###
# Basket Endpoints (Authorization: Bearer token with BasketFullPermission scope)
###

GET {{MultiShop.Cargo.Basket_HostAddress}}/api/basket
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{MultiShop.Cargo.Basket_HostAddress}}/api/basket
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "discountCode": "INDIRIM10",
