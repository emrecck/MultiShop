@page "/Admin/Comment/UpdateComment/{id}"
@model MultiShop.Web.Areas.Admin.Pages.Comment.UpdateCommentModel

@{
    ViewData["Title"] = "UpdateComment";
    Layout = "~/Areas/Admin/Pages/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Kategori Güncelleme Sayfası</h4>
                <br />
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <input type="hidden" asp-for="Input.UserCommentId" />
                        <input type="text" asp-for="Input.ProductId" />
                        <label>Kullanıcı Adı Soyadı</label>
                        <input type="text" class="form-control" asp-for="Input.NameSurname" />
                        <br />
                        <label>Kullanıcı Görsel</label>
                        <input type="text" class="form-control" asp-for="Input.ImageUrl" />
                        <br />
                        <label>Email Adresi</label>
                        <input type="text" class="form-control" asp-for="Input.Email" />
                        <br />
                        <label>Kullanıcı Puanı</label>
                        <input type="number" class="form-control" asp-for="Input.Rating" />
                        <br />
                        <label>Yorum Tarihi</label>
                        <input type="date" class="form-control" asp-for="Input.CreatedDate" />
                        <br />
                        <label>Yorum</label>
                        <textarea asp-for="Input.CommentDetail" class="form-control" rows="3"></textarea>
                        <br />
                        <button class="btn btn-success">Yorumu Güncelle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

